# Vercel AI Gateway (model calls)
AI_GATEWAY_API_KEY=

# InsForge (system of record). Server-only — never expose INSFORGE_API_KEY to a browser.
INSFORGE_URL=https://your-appkey.us-east.insforge.app
INSFORGE_API_KEY=
INSFORGE_ANON_KEY=

# One client company per agent deploy. Scopes memories, decisions, and company_documents.
# Example: pentridge, acme-co. Never reuse across clients.
COMPANY_TENANT_ID=pentridge

# GitHub MCP (app-scoped). Fine-grained PAT with Contents, Issues, Pull requests, Metadata.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Vercel MCP (app-scoped). Account token with access to the Pentridge team/projects.
# https://vercel.com/account/tokens
VERCEL_TOKEN=

# AgentMail MCP (inbox-scoped). Adzo inbox: agentadzo@agentmail.to
# https://console.agentmail.to
AGENTMAIL_API_KEY=

# Apify MCP (https://mcp.apify.com). Bearer token from Console → Settings → API & Integrations.
# https://console.apify.com/settings/integrations
APIFY_TOKEN=

# AlignoCRM (first-party REST). Settings API key via x-api-key. Server-only.
ALIGNO_API_URL=https://alignocrm.com
ALIGNO_API_KEY=

# Google Workspace as adzo@pentridgemedia.com (service account + domain-wide delegation).
# GOOGLE_SERVICE_ACCOUNT_JSON is the full service-account key JSON (one line).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE_USER=adzo@pentridgemedia.com
